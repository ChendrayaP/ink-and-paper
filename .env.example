# ─────────────────────────────────────────────────────────────────────────────
# INK & PAPER — environment configuration
#
# 1. Copy this file to `.env.local`  →  cp .env.example .env.local
# 2. Fill in the values below.
# 3. `.env.local` is git-ignored and must NEVER be committed.
#
# For production (Vercel): add the same variables under
#   Project → Settings → Environment Variables
# (Do not commit real values to the repo.)
# ─────────────────────────────────────────────────────────────────────────────

# Canonical public URL of the site. NO trailing slash.
#   Local dev  : http://localhost:3000
#   Production : https://your-custom-domain.com
# The app reads this for metadata, canonical URLs, and Open Graph. Changing the
# custom domain later is a change here only — never in application code.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — from your project's  Settings → API
# Safe to expose to the browser (protected by Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Supabase service-role key — SERVER ONLY.
#   • Never prefix with NEXT_PUBLIC.
#   • Never commit it. Never paste it into chat or a client file.
#   • It bypasses Row Level Security, so it lives only in server code.
# Used for privileged, validated server operations (e.g. moderated reader
# photo uploads in a later phase).
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ── Optional — added in later phases; leave blank for now ────────────────────
# Privacy-friendly analytics (e.g. Plausible / Umami). Blank = analytics off.
# NEXT_PUBLIC_ANALYTICS_DOMAIN=
# NEXT_PUBLIC_ANALYTICS_SRC=

# ── Development only ─────────────────────────────────────────────────────────
# Renders the public pages with sample data so the design can be reviewed
# WITHOUT putting anything in the database. Leave unset/absent in production.
# NEXT_PUBLIC_USE_DEV_FIXTURES=1
